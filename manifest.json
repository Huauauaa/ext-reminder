{
  "manifest_version": 3,
  "name": "HTTP Request Sender",
  "version": "1.0.0",
  "description": "在弹窗中发送 HTTP 请求：自定义 URL、Method、Headers、Body，查看响应。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "HTTP Request Sender",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "host_permissions": ["<all_urls>"]
}
